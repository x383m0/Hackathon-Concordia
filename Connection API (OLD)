const apiKey = "colle_ta_vraie_cle_ici";

// Collez ici le texte des conditions d'utilisation à analyser
const texteTOU = `Collez ici un extrait de conditions d'utilisation.`;

const SYSTEM_PROMPT = `Tu es un expert en protection de la vie privée et en droit du numérique.
On te donne le texte de conditions d'utilisation ou d'une politique de confidentialité.

Règles :
- Base-toi UNIQUEMENT sur le texte fourni. N'invente rien.
- Si une information est absente du texte, écris "non précisé" au lieu de deviner.
- Écris en français, dans un langage simple, sans jargon juridique.
- Si le texte n'est pas des conditions d'utilisation, mets "valid_document" à false et laisse le reste vide.

Réponds UNIQUEMENT avec un objet JSON valide (sans texte autour, sans markdown), avec exactement ces champs :

{
  "valid_document": true,
  "summary": "résumé en 2 à 4 phrases",
  "key_points": ["5 à 8 points clés courts"],
  "data_practices": {
    "data_collected": ["types de données collectées"],
    "purposes": ["raisons pour lesquelles elles sont utilisées"],
    "shared_with": ["catégories de tiers qui reçoivent les données"],
    "retention": "durée de conservation ou non précisé"
  },
  "risks": [
    { "title": "titre court", "severity": "low | medium | high", "explanation": "1 phrase", "quote": "extrait de moins de 20 mots, ou vide" }
  ],
  "criteria": {
    "sells_data_to_third_parties": 0,
    "shares_with_advertisers": 0,
    "tracking_and_profiling": 0,
    "sensitive_data_collected": 0,
    "indefinite_retention": 0,
    "no_deletion_right": 0,
    "broad_content_license": 0,
    "unilateral_changes": 0,
    "forced_arbitration": 0,
    "location_tracking": 0,
    "vague_language": 0
  }
}

Pour chaque champ de "criteria" : 0 = non ou non mentionné, 1 = partiel ou flou, 2 = oui, clairement.`;

async function analyser(texte) {
  const res = await fetch("https://api.groq.com/openai/v1/chat/completions", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${apiKey}`,
    },
    body: JSON.stringify({
      model: "openai/gpt-oss-120b",
      temperature: 0.1,
      response_format: { type: "json_object" },
      messages: [
        { role: "system", content: SYSTEM_PROMPT },
        { role: "user", content: texte },
      ],
    }),
  });

  if (!res.ok) {
    throw new Error(`Erreur ${res.status} : ${await res.text()}`);
  }

  const data = await res.json();
  const contenu = data.choices[0].message.content;

  try {
    return JSON.parse(contenu);
  } catch {
    throw new Error("Le modèle n'a pas renvoyé un JSON valide :\n" + contenu);
  }
}

analyser(texteTOU)
  .then((resultat) => console.log(JSON.stringify(resultat, null, 2)))
  .catch((err) => console.error(err.message));
