{
  "manifest_version": 3,
  "name": "FinePrint",
  "version": "2.1",
  "description": "Détecte les termes d'utilisation sur la page ouverte et les analyse avec l'IA.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "extension.html",
    "default_title": "Détecter les ToU",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
